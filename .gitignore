# Hodie .gitignore
# Keep structure, exclude content

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/

# Content folders (sync to Drive, not Git)
plexus/*/
!plexus/*/.gitkeep
duplicatus/*
!duplicatus/.gitkeep
exemplar/*
!exemplar/.gitkeep
gravitar/*
!gravitar/.gitkeep
rudera/strues/*
!rudera/strues/.gitkeep
rudera/fragmenta/*
!rudera/fragmenta/.gitkeep
rudera/pulvis/*
!rudera/pulvis/.gitkeep

# Logs and temp
*.log
*.tmp

# OS-specific files
.DS_Store
Thumbs.db

# Editor configurations
.vscode/
.idea/

# Local config
.env
*.local

# PWD reports (generated)
PWD_REPORT.txt

# Sensitive Personal Data - Added 2026-01-02
/storage/emulated/0/pixel8a/Q/no_sync_private/
**/medical_record/
**/education_record/
**/*DD214*
**/*Earnings*
**/*Financials*
**/*child support*
**/*TRSRetire*
**/Personal/
**/Stubs/
**/Google Photos/

# Financial and personal documents
*.xlsx
**/*Receipt*
**/*receipt*

# Local development (editor temp files)
*.swp
*.swo
*~

# Build-related directories
node_modules/
dist/
build/

# Large media and archive files
*.zip
*.tar.gz
*.tar.bz2
*.rar
*.7z
*.mp4
*.mp3
*.mov
*.avi
